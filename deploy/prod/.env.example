# SPDX-License-Identifier: GPL-3.0-or-later
# Copy to .env next to compose.yml and fill in the production values.

# --- Image / compose ---
# Fully-qualified OCI image to pull. Pin a version tag or digest for production.
IDP_REGISTER_IMAGE=registry.example.com/idp-register:0.1.0
# Bind only on loopback when Nginx/Caddy/Cloudflare Tunnel is on the same host.
IDP_REGISTER_BIND=127.0.0.1:8080

# --- HTTP ---
# Public origin seen by the browser. Must match the reverse-proxied URL exactly.
ORIGIN=https://register.example.com
# Restore the real client IP from CF-Connecting-IP when behind Cloudflare.
TRUST_CF_CONNECTING_IP=true

# --- Database ---
# Default SQLite path inside the app container. The compose file mounts /data.
SQLITE_PATH=/data/idp-register.db

# PostgreSQL is optional. To use it:
# 1. uncomment DATABASE_URL and POSTGRES_PASSWORD;
# 2. run: docker compose --profile postgres up -d
#
# DATABASE_URL=postgres://idp_register:replace-with-db-password@postgres:5432/idp_register?sslmode=disable
# POSTGRES_DB=idp_register
# POSTGRES_USER=idp_register
# POSTGRES_PASSWORD=replace-with-db-password

# --- Admin-auth OIDC Relying Party ---
# Generic OIDC config. This may point at Rauthy, Authentik, Dex, etc.
# For Rauthy, the issuer normally ends with /auth/v1/ including the trailing slash.
OIDC_ISSUER=https://auth.example.com/auth/v1/
OIDC_CLIENT_ID=idp-register
OIDC_CLIENT_SECRET=replace-with-oidc-client-secret
OIDC_REDIRECT_URI=https://register.example.com/auth/callback
OIDC_SCOPES=openid email profile groups

# Admin authorization. Prefer an admin group claim; use sub/email allow-lists
# only when the IdP cannot emit a reliable groups/roles claim.
OIDC_GROUPS_CLAIM=groups
OIDC_ADMIN_GROUP=svc:idp-register:admin
# OIDC_ADMIN_SUBS=
# OIDC_ADMIN_EMAILS=admin@example.com

# Groups never offered for registrant permission profiles. The app also adds
# OIDC_ADMIN_GROUP automatically.
PROFILE_GROUP_DENYLIST=admin,rauthy_admin

# --- Provisioning target IdP ---
PROVISIONER=rauthy
RAUTHY_API_BASE=https://auth.example.com/auth/v1
RAUTHY_API_KEY_NAME=idp-register
RAUTHY_API_KEY_SECRET=replace-with-rauthy-api-key-secret
RAUTHY_DEFAULT_LANGUAGE=en
RAUTHY_DEFAULT_TIMEZONE=UTC

# --- Sessions / cookies ---
SESSION_TTL_HOURS=12
SECURE_COOKIES=true
APP_ENV=production

# --- Anti-abuse ---
# Leave empty to disable Turnstile verification. If enabled, the frontend image
# must have been built with VITE_TURNSTILE_SITE_KEY for the same Cloudflare site.
# TURNSTILE_SECRET=
