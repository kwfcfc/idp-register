# SPDX-License-Identifier: GPL-3.0-or-later
# idp-register config matching deploy/dev/docker-compose.yml (Rauthy on :8080).
# idp-register runs on the HOST at :8081. Load before `go run`:
#   set -a; source deploy/dev/idp-register.env; set +a
#   go run ./cmd/server
# Throwaway test secrets — never reuse.

# --- HTTP (idp-register itself; :8080 is taken by Rauthy) ---
ADDR=:8081
ORIGIN=http://localhost:8081
TRUST_CF_CONNECTING_IP=false

# --- Database: local SQLite file ---
SQLITE_PATH=idp-register-dev.db

# --- Admin-auth OIDC RP (the bootstrapped Rauthy client) ---
# NOTE: Rauthy's issuer has a TRAILING SLASH; coreos/go-oidc requires an exact
# match, so this must end with "/auth/v1/" (verified against discovery).
OIDC_ISSUER=http://localhost:8080/auth/v1/
OIDC_CLIENT_ID=idp-register
OIDC_CLIENT_SECRET=9c6c109b601b78597d31c91653008e26086e1b0ff89629785cb9226006426e1a
OIDC_REDIRECT_URI=http://localhost:8081/auth/callback
# Quoted: the value has spaces, so `set -a; source ...` would otherwise try to
# run `email` as a command.
OIDC_SCOPES="openid email profile groups"
OIDC_GROUPS_CLAIM=groups
# Authorize the bootstrap admin by email (no group wiring needed for the test).
OIDC_ADMIN_EMAILS=admin@localhost

# --- Provisioning target IdP (Rauthy management API + bootstrapped key) ---
PROVISIONER=rauthy
RAUTHY_API_BASE=http://localhost:8080/auth/v1
RAUTHY_API_KEY_NAME=idp-register
RAUTHY_API_KEY_SECRET=75d205eb93bafde5982690d31d35c203d57a7b5c1273d3d9b78879d47b0ddf547da025085dbcd7e4

# --- Sessions / cookies (HTTP, local) ---
SESSION_TTL_HOURS=12
SECURE_COOKIES=false
APP_ENV=dev

# --- Anti-abuse: Turnstile disabled locally (set both to test the challenge) ---
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=

# --- Public-form content: disabled locally (set any to test the consent flow) ---
# FORM_RULES_TEXT=Dev rules: be nice.
# FORM_RULES_FILE=
# FORM_TERMS_URL=https://example.com/terms
