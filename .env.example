# SPDX-License-Identifier: GPL-3.0-or-later
# idp-register configuration. Copy to .env and fill in. See internal/config.

# --- HTTP ---
ADDR=:8080
# Public origin of this service (used for CSRF same-origin checks).
ORIGIN=https://register.example.com
# Restore the real client IP from CF-Connecting-IP (behind Cloudflare).
TRUST_CF_CONNECTING_IP=true

# --- Database (pick ONE) ---
# PostgreSQL: set DATABASE_URL and the SQLite path is ignored.
# DATABASE_URL=postgres://idp_register:change-me@postgres:5432/idp_register
# SQLite (default if DATABASE_URL is unset): a file path.
SQLITE_PATH=idp-register.db

# --- Admin-auth OIDC Relying Party (generic; NOT assumed to be Rauthy) ---
OIDC_ISSUER=https://auth.example.com/auth/v1/
OIDC_CLIENT_ID=idp-register
OIDC_CLIENT_SECRET=change-me
OIDC_REDIRECT_URI=https://register.example.com/auth/callback
OIDC_SCOPES=openid email profile groups
# Claim that carries group/role membership, and the value that grants admin.
OIDC_GROUPS_CLAIM=groups
OIDC_ADMIN_GROUP=svc:idp-register:admin
# Alternative allow-lists for IdPs without a usable groups claim (comma-separated).
# OIDC_ADMIN_SUBS=
# OIDC_ADMIN_EMAILS=

# --- Provisioning target IdP (behind the Provisioner interface) ---
PROVISIONER=rauthy
# Rauthy management API. Create an API key scoped to Users: create, read, update.
RAUTHY_API_BASE=https://auth.example.com/auth/v1
RAUTHY_API_KEY_NAME=idp-register
RAUTHY_API_KEY_SECRET=replace-with-a-long-rauthy-api-key-secret
RAUTHY_DEFAULT_LANGUAGE=en
RAUTHY_DEFAULT_TIMEZONE=UTC

# --- Sessions / cookies ---
SESSION_TTL_HOURS=12
# Set true in production (HTTPS) so cookies carry the Secure attribute.
SECURE_COOKIES=true
APP_ENV=production

# --- Anti-abuse ---
# Cloudflare Turnstile secret; leave empty to disable CAPTCHA verification.
# TURNSTILE_SECRET=
