# Public origin of this admin site.
ORIGIN=https://invite-admin.example.com

# PostgreSQL
DATABASE_URL=postgresql://invite_admin:change-me@postgres:5432/invite_admin

# Rauthy OIDC client for administrator login.
OIDC_ISSUER=https://auth.example.com/auth/v1/
OIDC_CLIENT_ID=invite-admin
OIDC_CLIENT_SECRET=change-me
OIDC_REDIRECT_URI=https://invite-admin.example.com/auth/callback
OIDC_SCOPES=openid email profile groups
OIDC_ADMIN_GROUP=svc:invite-admin:admin

# Rauthy management API. Create an API key with Users: create, read, update.
RAUTHY_API_BASE=https://auth.example.com/auth/v1
RAUTHY_API_KEY_NAME=invite-portal
RAUTHY_API_KEY_SECRET=replace-with-a-long-rauthy-api-key-secret
RAUTHY_DEFAULT_LANGUAGE=en
RAUTHY_DEFAULT_TIMEZONE=UTC

# Used to hash invite codes before storing them. At least 32 random bytes.
INVITE_HMAC_KEY=replace-with-64-or-more-random-characters

# Opaque admin sessions.
SESSION_TTL_HOURS=12
NODE_ENV=production
