{
    "name": "idp-register",
    "private": true,
    "version": "0.1.0",
    "description": "Workspace root for idp-register. The Go backend lives in cmd/ and internal/; the SvelteKit frontend lives in web/.",
    "type": "module",
    "scripts": {
        "dev": "pnpm --filter idp-register-web dev",
        "build": "pnpm --filter idp-register-web build",
        "check": "pnpm --filter idp-register-web check",
        "docs:build": "mdbook build docs/book",
        "docs:serve": "mdbook serve docs/book",
        "update:acp": "pnpm -C tools/cli up --latest @agentclientprotocol/claude-agent-acp @agentclientprotocol/codex-acp"
    },
    "engines": {
        "node": ">=24"
    },
    "packageManager": "pnpm@11.28.9+sha512.35421cea2720eca3f5ad722b67e8ef18f4d3cd4745ed2fcfeb0dc288d4e9437fad3870d91ee6e83f268f0f6f7e0f62723317b19617bb45ee4333172ef51159f8"
}
