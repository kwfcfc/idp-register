use flake .
# add tools-cli path only
tools_cli_bin="$PWD/.direnv/tools-cli-bin"
mkdir -p "$tools_cli_bin"

make_tools_cli_wrapper() {
  name="$1"
  target="$PWD/tools/cli/node_modules/.bin/$name"
  wrapper="$tools_cli_bin/$name"

  if [ -L "$wrapper" ]; then
    echo "Remove stale symlink once: $wrapper" >&2
    return 1
  fi

  if [ -e "$wrapper" ]; then
    return 0
  fi

  printf '#!/usr/bin/env sh\nexec "%s" "$@"\n' "$target" > "$wrapper"
  chmod +x "$wrapper"
}

make_tools_cli_wrapper claude-agent-acp || return
make_tools_cli_wrapper codex-acp || return
make_tools_cli_wrapper svelteserver || return
make_tools_cli_wrapper typescript-language-server || return

PATH_add "$tools_cli_bin"

